<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Tests run on PostgreSQL, like production. SQLite cannot stand in
            here: its LIKE folds case for ASCII only, so a Cyrillic search would
            pass in production and fail in tests (or worse, the reverse). Host,
            user and password come from .env; only the database name is
            overridden. Create it once with: createdb bismar_testing
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="bismar_testing"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!--
            Поисковика в тестах нет, и это намеренно: живой Meilisearch стоит
            один на несколько приложений, и прогон тестов не должен переписывать
            его индексы. На драйвере `null` каталог ищет запасным путём — тем
            самым, что работает и в жизни, когда сервер не поднят. Обращение к
            самому поисковику проверяется подставным движком, см. CatalogSearchTest.
        -->
        <env name="SCOUT_DRIVER" value="null"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
