APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8100

# Origin of the Nuxt SPA. Used for CORS and Sanctum's stateful domains.
FRONTEND_URL=http://localhost:3100
SANCTUM_STATEFUL_DOMAINS=localhost:3100,127.0.0.1:3100

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database

# Сколько минут живёт сессия — неделя. Срок скользящий: каждый ответ продлевает
# его заново, так что выкидывает только того, кто не заходил семь дней подряд.
# Сотрудник работает в системе целый день и не должен входить снова после обеда.
SESSION_LIFETIME=10080

SESSION_ENCRYPT=false
SESSION_PATH=/
# Shared across ports so the SPA on :3100 and the API on :8100 use the same session cookie.
SESSION_DOMAIN=localhost

# Мессенджер сотрудников работает через сокеты, и вещает их Reverb — свой
# сокет-сервер, поднимаемый рядом с приложением: `php artisan reverb:start`.
# Держать его надо под supervisor, а снаружи пробрасывать через nginx как wss.
# Оставьте log, если сокеты не нужны: переписка при этом сохраняется и читается,
# но новое сообщение появится у собеседника только после обновления страницы.
BROADCAST_CONNECTION=reverb

# Ключи сокет-сервера. Их же (кроме секрета) знает фронтенд — им он
# подписывается при подключении.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 — lesson attachments are stored on the `s3` disk.
# Fill these in before uploading files; tests use Storage::fake and need nothing here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Сроки ожидания хранилища, в секундах. Без них SDK ждёт ответа сколько угодно,
# и одна загрузка при недоступном хранилище занимает процесс целиком.
# Соединение — скупо: до недоступного хранилища не достучаться за секунды.
# Ответ — щедро: большой файл заливается дольше.
AWS_CONNECT_TIMEOUT=5
AWS_TIMEOUT=60
# Повторов меньше, чем три по умолчанию: недоступное хранилище умножает на них
# каждое ожидание, а сотрудник в это время смотрит на индикатор.
AWS_RETRIES=1

# Maximum upload size for a lesson attachment, in kilobytes.
LESSON_ATTACHMENT_MAX_KB=51200
# Uploaded lesson video limit in KB (500 MB). PHP's upload_max_filesize must allow it too.
LESSON_VIDEO_MAX_KB=512000

# Предел для файла расшифровки. Расшифровка — обычный текст, и десяти мегабайт
# хватает на сутки записи с запасом: файл, который сюда не помещается, почти
# наверняка не расшифровка вовсе.
LESSON_TRANSCRIPT_MAX_KB=10240

# Консультант по базе знаний. Без ключа страница /lms/assistant отвечает
# «Консультант сейчас недоступен» — остальное приложение работает как обычно.
#
# Заполняется РОВНО ОДНА из двух строк — та, которую ждёт эндпоинт:
#   API_KEY    — ключ Anthropic, уходит в заголовке X-Api-Key;
#   AUTH_TOKEN — ключ туннеля или прокси, уходит в Authorization: Bearer.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=

# Адрес API. Пусто — api.anthropic.com; заполняется, если запросы идут через
# туннель или прокси. Указывается БЕЗ /v1 — SDK дописывает v1/messages сам.
# Путь сохраняется: https://tunnel.example.com/anthropic получит
# /anthropic/v1/messages. Хвостовой слэш можно не убирать.
ANTHROPIC_BASE_URL=

# Модель смыслового поиска, OpenAI-совместимый /v1/embeddings по тому же адресу
# и с тем же ключом. Пусто — поиск остаётся словесным: он работает, но не
# связывает «как подобрать краску» с «Матрицей подбора», где нет ни одного
# общего слова. Без неё же не работает и выдача готовых ответов дословно.
AI_EMBEDDING_MODEL=

# Когда ответ из таблицы урока отдаётся дословно, без обращения к модели.
# THRESHOLD — насколько близко вопрос сотрудника должен совпасть со строкой,
# MARGIN — насколько лучшая строка должна опережать вторую. Оба зависят от
# модели эмбеддингов и подлежат калибровке на живых вопросах: слишком высокий
# порог просто стоит денег, слишком низкий отдаёт ответ не на тот вопрос.
AI_VERBATIM_THRESHOLD=0.75
AI_VERBATIM_MARGIN=0.05

# Ниже этой близости строка таблицы считается не относящейся к вопросу. Порог
# нужен ради честного «ничего не нашли»: без него на любой вопрос возвращаются
# наименее посторонние строки, и запасной поиск по тексту урока не срабатывает.
AI_ANSWERS_FLOOR=0.45

# Насколько строка может уступать лучшей и всё ещё уходить модели. Считается от
# лучшего совпадения в конкретной выдаче. Нужно ради слабых моделей: получив
# восемь строк, из которых подходит одна, они отвечают по приглянувшейся либо
# решают, что материала нет вовсе.
AI_ANSWERS_RELATIVE_FLOOR=0.75

# Сколько прошлых кругов «вопрос — ответ» консультант помнит у каждого сотрудника.
# Без памяти каждый вопрос читается как первый, и «а сколько это сохнет?» через
# сообщение после верного ответа не значит ничего. Разговор уходит модели целиком,
# так что число — это ещё и токены на каждом вопросе.
AI_CONVERSATION_TURNS=20

# Близкое по теме: сколько соседнего материала консультант предлагает посмотреть,
# когда прямого ответа не нашлось или когда нашлось не только это, и ниже какой
# близости строка не относится к вопросу даже отдалённо. Второй порог — широкий,
# рядом с AI_ANSWERS_FLOOR: тот решает, можно ли этим отвечать, этот — стоит ли
# это вообще показывать.
AI_RELATED_PER_REPLY=4
AI_ANSWERS_RELATED_FLOOR=0.35

# Сервер аналитики — ClickHouse, который наполняет ночная выгрузка из 1С.
# Права там только на чтение, и большего приложению не нужно. Стоит в локальной
# сети, поэтому снаружи офиса дашборд честно отвечает «сервер недоступен», а не
# падает.
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=mart
CLICKHOUSE_USERNAME=reader
CLICKHOUSE_PASSWORD=
CLICKHOUSE_HTTPS=false

# Читается витринный слой, а не сырой. В сыром рознице соответствуют два потока
# сразу, себестоимость стоит у трёх четвертей строк, а RFM, когорт и ABC/XYZ нет
# вовсе — запросом они не восстанавливаются.
ANALYTICS_DATABASE=mart

# Запрос по двум миллионам строк идёт секунды, поэтому ответ живёт в кэше.
# Витрина пересобирается ночью, так что в течение дня один и тот же вопрос даёт
# один и тот же ответ.
ANALYTICS_CACHE_TTL=300

# Сколько строк возвращают рейтинги. Предел стоит на сервере: 29 тысяч
# артикулов в ответе не нужны никому.
ANALYTICS_TOP_LIMIT=15
ANALYTICS_MAX_TOP_LIMIT=100

VITE_APP_NAME="${APP_NAME}"
